# Postgres connection string. Any provider works — Drizzle talks to a plain
# connection string, not a vendor-specific API. See
# specs/001-account-progress-sweep/research.md ("Database / query layer").
DATABASE_URL=

# A GitHub personal access token with read access to the repos being
# assessed (public + private, per FR-009). Never committed, never held by
# the app on anyone else's behalf (Constitution Principle VIII).
GITHUB_TOKEN=

# Which LLM vendor/model performs assessments is an operator config choice,
# never a code-level one (Constitution Principle VII, NON-NEGOTIABLE).
# LLM_PROVIDER is one of: openai | anthropic | openai-compatible
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Only used when LLM_PROVIDER=openai-compatible (e.g. a self-hosted vLLM,
# LM Studio, or Ollama server exposing an OpenAI-compatible endpoint).
LLM_BASE_URL=
